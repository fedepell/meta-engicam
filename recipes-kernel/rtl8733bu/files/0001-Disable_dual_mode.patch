From 71f9d0755c7ff0a128d80861f68bb8deeb402e9c Mon Sep 17 00:00:00 2001
From: Federico Francescon <federico.francescon@higeco.com>
Date: Tue, 16 Jul 2024 11:33:12 +0200
Subject: [PATCH] Revert "Enable concurrent mode in driver"

This reverts commit bdcbe1798b9cf93721a17454a39349f19b4d5c83.
---
 rtl8733b.mk | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/rtl8733b.mk b/rtl8733b.mk
index 5fbda7b..21341b2 100644
--- a/rtl8733b.mk
+++ b/rtl8733b.mk
@@ -1,9 +1,5 @@
 EXTRA_CFLAGS += -DCONFIG_RTL8733B
 
-# Enable concurrent mode in driver so we have two interfaces visible
-# and can do both STA and AP at the same time
-EXTRA_CFLAGS += -DCONFIG_CONCURRENT_MODE -DCONFIG_IFACE_NUMBER=2
-
 #ifeq ($(CONFIG_MP_INCLUDED), y)
 ### 8733B Default Enable VHT MP HW TX MODE ###
 #EXTRA_CFLAGS += -DCONFIG_MP_VHT_HW_TX_MODE

